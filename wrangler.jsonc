{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getmyinvite",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "getmyinvite"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP_SERVER", "class_name": "AppServer" }]
  },
  "migrations": [
    { "tag": "v1-app-server", "new_sqlite_classes": ["AppServer"] }
  ],
  "keep_vars": true,
  "minify": true,
  "observability": {
    "enabled": true
  }
}
