{
  "crons": [
    {
      "path": "/api/cron/cleanup-drafts",
      "schedule": "0 22 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "getmyinvite.vercel.app"
        }
      ],
      "destination": "https://getmyinvite.in/:path*",
      "permanent": true
    }
  ]
}
